{
  "expo": {
    "name": "SAMS",
    "slug": "sams",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/lnmiit_favicon.png",
    "scheme": "sams",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1F3A",
        "foregroundImage": "./assets/images/lnmiit_favicon.png",
        "backgroundImage": "./assets/images/lnmiit_favicon.png",
        "monochromeImage": "./assets/images/lnmiit_favicon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B1F3A"
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SAMS to scan admission gate passes.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "favicon": "./assets/images/lnmiit_favicon.png",
      "bundler": "metro"
    }
  }
}
