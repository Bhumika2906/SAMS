NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/sams
JWT_SECRET=replace-with-a-long-random-string-for-local-dev
JWT_EXPIRES_IN=7d

# StorageService: "local" (default) or "cloudinary"
STORAGE_ADAPTER=local
LOCAL_UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

# Optional Cloudinary (leave empty; app works without these)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

OTP_TTL_SECONDS=300
LOG_LEVEL=info
