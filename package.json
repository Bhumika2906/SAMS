{
  "name": "sams",
  "private": true,
  "version": "0.0.0",
  "description": "Student Admission Management System — LNMIIT Jaipur",
  "workspaces": [
    "shared",
    "server",
    "mobile"
  ],
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "seed": "npm run seed -w server",
    "server": "npm run dev -w server",
    "mobile": "npm run start -w mobile"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "eslint": "^9.38.0",
    "globals": "^16.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
